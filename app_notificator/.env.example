# Для каждого провайдера задаётся пара переменных:
#   <PROV> — значение prov.prov из таблицы провайдеров,
#   токен бота и ID чата, в который пересылаются SMS этого провайдера.
TG_TOKEN_PROV1=123456:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TG_CHAT_ID_PROV1=-1001001001001
TG_TOKEN_PROV2=123456:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TG_CHAT_ID_PROV2=-1002002002002

# Подключения к БД в Docker подставляются автоматически из корневого docker-compose.yml.
# Раскомментируйте, чтобы запустить приложение локально, без контейнера:
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=goipuser
# DB_PASSWORD=goippass
# DB_NAME=goip
